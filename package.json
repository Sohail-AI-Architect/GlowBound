{
  "name": "glowbound",
  "version": "1.0.0",
  "private": true,
  "description": "GlowBound - a neon arcade survival game built with Next.js, TypeScript and HTML5 Canvas.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/engine.test.ts tests/storage.test.ts tests/utils.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
